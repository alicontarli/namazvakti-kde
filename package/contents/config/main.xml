    <entry name="notifyOnTime" type="Bool">
      <default>false</default>
    </entry>
    <entry name="notifyBeforeMinutes" type="Int">
      <default>0</default>
    </entry>
    <entry name="language" type="String">
      <default>auto</default>
    </entry>
